# --- Notion -------------------------------------------------------------
# Jeton de l'integration interne Notion (commence par "ntn_" ou "secret_").
# A creer sur https://www.notion.so/profile/integrations puis partager la base
# "Vrac a classer" avec cette integration (menu ... > Connexions).
NOTION_TOKEN=

# Identifiant de la base "Vrac a classer" (2nd brain).
NOTION_DATABASE_ID=c3e6ee5fcd8742b3a08c70e20cb4cb5d

# --- Gmail --------------------------------------------------------------
# Prefixe declencheur, compare au debut de l'objet (insensible a la casse).
GMAIL_SUBJECT_PREFIX=Vrac -

# Label pose sur les mails deja importes : c'est LUI qui evite les doublons.
# Il est cree automatiquement au premier passage.
GMAIL_PROCESSED_LABEL=Notion/Vrac importe

# Fenetre de recherche, en jours. Les mails plus vieux sont ignores.
GMAIL_SEARCH_WINDOW_DAYS=30

# Archiver le mail (retirer de la boite de reception) une fois importe.
GMAIL_ARCHIVE_AFTER_IMPORT=false

# Nombre max de mails traites par passage (garde-fou).
GMAIL_MAX_PER_RUN=25

# --- Divers -------------------------------------------------------------
# Longueur max du corps recopie dans la page Notion.
MAX_BODY_CHARS=12000
