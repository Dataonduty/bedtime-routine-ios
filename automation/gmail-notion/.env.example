# --- Notion -------------------------------------------------------------
# Jeton de l'integration interne Notion (commence par "ntn_" ou "secret_").
# A creer sur https://www.notion.so/profile/integrations puis partager la base
# "Vrac a classer" avec cette integration (menu ... > Connexions).
NOTION_TOKEN=

# Identifiant de la base "Vrac a classer" (2nd brain).
NOTION_DATABASE_ID=c3e6ee5fcd8742b3a08c70e20cb4cb5d

# --- Gmail --------------------------------------------------------------
# Prefixe declencheur, compare au debut de l'objet (insensible a la casse).
GMAIL_SUBJECT_PREFIX=Vrac -

# Label pose sur les mails deja importes : c'est LUI qui evite les doublons.
# Il est cree automatiquement au premier passage.
GMAIL_PROCESSED_LABEL=Notion/Vrac importe

# Fenetre de recherche, en jours. Les mails plus vieux sont ignores.
GMAIL_SEARCH_WINDOW_DAYS=30

# Archiver le mail (le retirer de la boite de reception) une fois importe.
# Le mail n'est pas supprime : il reste dans « Tous les messages ».
GMAIL_ARCHIVE_AFTER_IMPORT=true

# Retirer le bloc de signature du corps recopie dans Notion.
STRIP_SIGNATURE=true

# Longueur max de ce qui suit un trait de separation pour etre tenu pour une
# signature. Au-dela, le trait est considere comme une mise en forme du texte.
SIGNATURE_MAX_CHARS=400

# Nombre max de mails traites par passage (garde-fou).
GMAIL_MAX_PER_RUN=25

# --- Images et pieces jointes -------------------------------------------
# Televerser les images dans Notion (piece jointe ou image collee dans le corps).
UPLOAD_IMAGES=true

# Taille minimale d'une image pour etre televersee, en octets. Filtre les pixels
# de suivi et les logos de signature des mails HTML. 8000 = environ 8 ko.
MIN_IMAGE_BYTES=8000

# Televerser aussi les fichiers non-images (PDF, etc.). Par defaut ils sont
# seulement listes par leur nom, et restent dans Gmail.
UPLOAD_OTHER_ATTACHMENTS=false

# Nombre max de fichiers televerses par mail.
MAX_FILES_PER_MAIL=10

# --- Divers -------------------------------------------------------------
# Longueur max du corps recopie dans la page Notion.
MAX_BODY_CHARS=12000

# Version d API pour l envoi de fichiers (l upload exige une version recente,
# les pages restent en 2022-06-28). A changer si Notion fait evoluer son API.
NOTION_UPLOAD_VERSION=2026-03-11
